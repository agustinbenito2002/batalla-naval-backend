PORT=3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain

# Configure both only when Node.js itself terminates HTTPS.
# If a hosting platform or reverse proxy provides HTTPS, leave both unset.
# TLS_KEY_PATH=certs/private-key.pem
# TLS_CERT_PATH=certs/fullchain.pem
